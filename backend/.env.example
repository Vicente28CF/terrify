# ─── Django ───────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=cambia-esto-por-una-clave-secreta-muy-larga-y-random-123456

# ─── Base de datos ────────────────────────────────────────────────
DB_NAME=terrify_db
DB_USER=terrify_user
DB_PASSWORD=terrify_pass
DB_HOST=db
DB_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Cloudinary (llenar después de crear cuenta gratis) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (llenar después de crear cuenta gratis) ───────────────
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@terrify.mx

# ─── Frontend URL (para enlaces en emails) ────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Producción (sobreescribir en deploy) ───────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Google OAuth (llenar después de crear proyecto en Google Cloud)
GOOGLE_CLIENT_ID=

# ─── Límites de imágenes (opcional, valores por defecto) ─────────
TERRIFY_MAX_TERRAIN_IMAGES=10
TERRIFY_MAX_IMAGE_FILE_SIZE=5242880
